{
    "name": "ceibacore/ceiba-db",
    "description": "CeibaDB \u2014 Lightweight PDO query builder and database abstraction layer for Ceiba Core ecosystem",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ceiba Core Team",
            "homepage": "https://github.com/ceibacore"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
        "ext-pdo": "*"
    },
    "autoload": {
        "files": [
            "lemurdb.php"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}